<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <Version>10.0.2</Version>
    <PackageId>LoomKit.Workflows</PackageId>
    <Authors>Andrea Furlan</Authors>
    <Description>A workflow orchestration library for .NET built around a job-queue model: workflows are sequences of activities executed through named queues and consumers, with support for branching, fork/re-join, resume-token-based pausing, retry middleware, and a fully extensible handler pipeline.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/andreafoorlan/LoomKit.Workflows</PackageProjectUrl>
    <RepositoryUrl>https://github.com/andreafoorlan/LoomKit.Workflows</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>workflow;orchestration;activities;queue;dependency-injection;dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Copyright>Copyright (c) 2026 Andrea Furlan</Copyright>
  </PropertyGroup>

  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LoomKit.Workflows.Abstractions" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

</Project>
